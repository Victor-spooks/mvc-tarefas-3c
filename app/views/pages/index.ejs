<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Integração com SGBD </title>
</head>

<body>
    <h1>Lista de tarefas a fazer - 3C</h1>

    <button onclick="window.location='/cadastro'">Nova Tarefa</button>

    <br>
    <br>

    <table>
        <thead>
            <tr>
                <th>Código</th>
                <th>Tarefa</th>
                <th>Prazo</th>
                <th>Situação</th>
                <th>Ações</th>
            </tr>
        </thead>
 <tbody>
<% 
if (linhasTabela && linhasTabela.length > 0) { 

    let situacoes = ["Cancelada", "Pendente", "Iniciada", "Finalizada", "Em Atraso"];

    linhasTabela.forEach(tarefa => { 
%>
    <tr>
        <td><%= tarefa.id_tarefa %></td>
        <td><%= tarefa.nome_tarefa %></td>
        <td><%= moment(tarefa.prazo_tarefa).format("DD/MM/YYYY") %></td>

        <td>
            <%= situacoes[parseInt(tarefa.situacao_tarefa)] || "Desconhecido" %>
        </td>

        <td>
            <a href="/alterar?id=<%= tarefa.id_tarefa %>">Editar</a> |
            <a href="/excluir?id=<%= tarefa.id_tarefa %>"
               onclick="return confirm('Tem certeza que deseja excluir esta tarefa?')">
               Excluir
            </a>
        </td>
    </tr>
<% 
    }); 
} 
%>
</tbody>

    </table>

</body>

</html>